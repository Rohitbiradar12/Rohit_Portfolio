# Existing browser-visible EmailJS configuration
VITE_APP_EMAILJS_SERVICE_ID=
VITE_APP_EMAILJS_TEMPLATE_ID=
VITE_APP_EMAILJS_AUTOREPLY_TEMPLATE_ID=
VITE_APP_EMAILJS_PUBLIC_KEY=

# Server-only. Never add VITE_ to any of these names.
ASK_ROHIT_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Generate a random value at least 32 characters long.
ASK_ROHIT_IP_SALT=
ASK_ROHIT_CHAT_PER_HOUR=15
ASK_ROHIT_COMPARE_PER_HOUR=4
ASK_ROHIT_DAILY_REQUESTS=100
ASK_ROHIT_MONTHLY_REQUESTS=1000
